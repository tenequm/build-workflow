python_paths := "src tests scripts ../skills/build-run/scripts ../skills/build-plan/scripts ../skills/build-close/scripts"

# Non-mutating checks, also run by the repository's existing hook runner.
check:
    uv run python scripts/sync-skill-code.py --check
    uv run ty check src ../skills/build-run/scripts ../skills/build-plan/scripts/plan-check.py ../skills/build-close/scripts
    uv run ruff check --config pyproject.toml {{python_paths}}
    uv run ruff format --check --config pyproject.toml {{python_paths}}

# Exercise the installed plugin against an isolated, patched copy of the source engine.
test *ARGS:
    uv run python scripts/acceptance.py {{ARGS}}

fix:
    uv run ruff check --fix --config pyproject.toml {{python_paths}}
    uv run ruff format --config pyproject.toml {{python_paths}}
    uv run python scripts/sync-skill-code.py

install:
    uv sync --all-groups

update:
    uv lock --upgrade
    uv sync --all-groups
