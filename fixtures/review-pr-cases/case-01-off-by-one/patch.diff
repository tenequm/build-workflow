+def calculate_total_pages(total_items: int, per_page: int) -> int:
+    """Calculate total number of pages needed for total_items."""
+    if total_items < 0 or per_page <= 0:
+        raise ValueError("Invalid total_items or per_page")
+    if total_items == 0:
+        return 0
+    return (total_items + per_page) // per_page
